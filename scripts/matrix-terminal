#!/usr/bin/env python3
"""Launch an optional Matrix session without editing terminal or shell config."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import tomllib

ROOT = Path(__file__).resolve().parent.parent


def ghostty_options(colors, font_size, phosphor):
    options = [
        "gtk-single-instance=false", "font-family=JetBrainsMono Nerd Font",
        f"font-size={font_size}", "window-padding-x=18", "window-padding-y=16",
        "adjust-cell-height=8%", "cursor-style=block", "cursor-style-blink=false",
        "shell-integration-features=no-cursor,ssh-env", "background-opacity=1",
        "custom-shader=", "custom-shader-animation=false",
        f"env=STARSHIP_CONFIG={ROOT / 'extras/starship.toml'}",
    ]
    for key in ("background", "foreground", "cursor-color", "cursor-text",
                "selection-background", "selection-foreground"):
        source = {"cursor-color": "cursor", "cursor-text": "background"}.get(key, key.replace("-", "_"))
        options.append(f"{key}={colors[source]}")
    options += [f"palette={i}={colors[f'color{i}']}" for i in range(16)]
    if phosphor:
        options.append(f"custom-shader={ROOT / 'extras/phosphor.glsl'}")
    return options


def foot_options(colors, font_size):
    options = [f"font=JetBrainsMono Nerd Font:size={font_size}", "pad=18x16",
               "cursor.style=block", "cursor.blink=no", "colors-dark.alpha=1.0"]
    for key in ("background", "foreground", "selection-background", "selection-foreground"):
        options.append(f"colors-dark.{key}={colors[key.replace('-', '_')].lstrip('#')}")
    options.append(f"colors-dark.cursor={colors['background'][1:]} {colors['cursor'][1:]}")
    for i in range(16):
        key = f"regular{i}" if i < 8 else f"bright{i - 8}"
        options.append(f"colors-dark.{key}={colors[f'color{i}'][1:]}")
    return options


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--terminal", choices=["ghostty", "foot"], default="ghostty")
    parser.add_argument("--font-size", type=float, default=11)
    parser.add_argument("--phosphor", action="store_true", help="enable a static Ghostty glow")
    parser.add_argument("--check", action="store_true", help="validate config without opening a window")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="optional command after --")
    args = parser.parse_args()
    if not 6 <= args.font_size <= 48:
        parser.error("font-size must be between 6 and 48")
    if args.phosphor and args.terminal != "ghostty":
        parser.error("--phosphor requires Ghostty")
    if not shutil.which(args.terminal):
        parser.error(f"{args.terminal} is not installed")
    colors = tomllib.loads((ROOT / "colors.toml").read_text())
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    env = os.environ.copy()
    env["STARSHIP_CONFIG"] = str(ROOT / "extras/starship.toml")
    if args.terminal == "ghostty":
        options = ghostty_options(colors, args.font_size, args.phosphor)
        if args.check:
            with tempfile.TemporaryDirectory(prefix="matrix-check-") as directory:
                config = Path(directory) / "config"
                config.write_text("\n".join(options) + "\n")
                return subprocess.call(["ghostty", "+validate-config", f"--config-file={config}"], env=env)
        argv = ["ghostty", *(f"--{option}" for option in options)]
        if command:
            argv += ["-e", *command]
    else:
        argv = ["foot"]
        for option in foot_options(colors, args.font_size):
            argv += ["--override", option]
        if args.check:
            argv += ["--check-config"]
        else:
            argv += ["--", *command]
    os.execvpe(argv[0], argv, env)


if __name__ == "__main__":
    raise SystemExit(main())
